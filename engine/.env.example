# העתיקו לקובץ .env באותה תיקייה ומלאו. את .env לא שומרים בגיט ולא שולחים לאף אחד.
# בענן (Railway) - אותם שמות, בלשונית Variables של השירות.

# ---- חובה ----
# וואטסאפ דרך whapi.cloud - הטוקן של הערוץ (המספר של הסוכן)
WHAPI_TOKEN=
WHAPI_URL=https://gate.whapi.cloud
# Claude - מפתח API מ-console.anthropic.com
ANTHROPIC_API_KEY=
# קבצי המוצר מתוך knowledge/, בלי .md. כמה מוצרים - מופרדים בפסיק, לכל אחד משפט טריגר משלו
PRODUCTS=demo-project-sales
# השם שהסוכן אומר ללקוח: "אני בודק מול X וחוזר אליך"
OWNER_NAME=
# הנייד של הבעלים, בפורמט 9725XXXXXXXX - אליו מגיעות ההעברות והסיכום, וממנו פקודות "AI אפס"
OWNER_PHONE=

# ---- מצב ----
# test - עונה רק לרשימה הלבנה · live - לכל מי שכותב את משפט הטריגר
MODE=test
# מספרי הבודקים במצב test, מופרדים בפסיק
TEST_WHITELIST=

# ---- יומן (רק למוצר שבסעיף 5 שלו יש ימים ושעות) ----
# חשבון שירות ב-Google Cloud עם Calendar API, והיומן משותף איתו עם הרשאת עריכה.
# בענן - קובץ המפתח בבסיס 64 · במחשב - קובץ google-calendar-key.json בתיקייה, או נתיב
GOOGLE_KEY_B64=
GOOGLE_KEY_FILE=
# המייל של היומן. בלי - היומן של חשבון השירות עצמו
CALENDAR_ID=

# ---- רשות ----
# הדגם והתקציב לכל תשובה. דגם שחושב לפני שכותב (Sonnet 5) צריך תקציב גדול - החשיבה נספרת בו
ENGINE_MODEL=claude-sonnet-4-5
ENGINE_MAX_TOKENS=6000
# שעת סיכום הבוקר לבעלים (שעון ישראל), או off
SUMMARY_AT=08:30
# פקודות מהנייד של הבעלים מתחילות במילה הזו ("AI אפס 050-1234567" - מאפס שיחה)
OWNER_KEYWORDS=AI
# מילות טריגר של סוכן אחר שעונה על אותו מספר - המנוע לא ייגע בלידים שלו
OTHER_AGENT_KEYWORDS=
# מילים של מוצר שהליד לא פנה אליו, ואסור להציע אותו מיוזמת הסוכן. למשל: השכרה,להשכרה
OFFER_BLOCK=
# ליד שכותב בלי משפט טריגר: מילים שמראות שהוא שלנו, ומילים של הסוכן האחר (אם יש כזה).
# בלי שום רמז - הסוכן שולח פתיחה: "שלום, פנית אלינו ל<BUSINESS_NAME> - כיצד אפשר לסייע?"
INTENT_WORDS=לקנות,לרכוש,רכישה,קנייה,קניה
OTHER_AGENT_INTENT_WORDS=
BUSINESS_NAME=מגדלי הדוגמה
# ההודעה השבועית לבעלים (ראשון, SUMMARY_AT): Anthropic נספר מכל קריאה. Whapi - מחיר קבוע לחודש לפי החשבון שלכם
# (0 - בלי השורה). WHAPI_SHARE - החלק של הסוכן הזה: ריק ← 1, או 0.5 כשיש סוכן אחר על אותו מספר
WHAPI_MONTHLY_USD=12
WHAPI_SHARE=
# "אחשוב על זה" ← הודעת מעקב אחרי X שעות, בשעה Y
FOLLOW_UP_HOURS=48
FOLLOW_UP_AT=15:00
# איפה נשמרים כרטיסי הלידים. בענן - על דיסק קבוע (Volume)
DATA_DIR=
